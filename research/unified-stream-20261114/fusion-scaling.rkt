#lang racket/base
(require rackunit json "catenable.rkt" (prefix-in c: "c.rkt"))
(define (source n)
  (let loop ([i 0])
    (λ () (if (> i n) (c:done) (values (list i) (loop (add1 i)))))))
(define naive-calls 0)
(define (naive s t)
  (λ ()
    (set! naive-calls (add1 naive-calls))
    (define-values (r next) (s))
    (if r (values r (naive next t)) (t))))
(define (again merge n)
  (define s (source n))
  (for ([_ (in-range n)])
    (define-values (r next) ((merge s c:done)))
    (set! s next))
  (check-equal? (c:amb-take #f s) (list n)))
(define rows
  (append
   (for*/list ([which '(append level)] [n '(2000 4000 8000 16000 32000)])
     (collect-garbage)
     (define before (cat-steps))
     (define-values (vs cpu real gc)
       (time-apply (λ () (again (if (eq? which 'append) c:amb-append c:amb-level) n)) '()))
     (define steps (- (cat-steps) before))
     (check-true (<= steps (* 4 n)))
     (hash 'strategy (symbol->string which) 'n n 'cpu_ms cpu 'cat_steps steps))
   (for/list ([n '(500 1000 2000 4000)])
     (set! naive-calls 0)
     (collect-garbage)
     (define-values (vs cpu real gc) (time-apply (λ () (again naive n)) '()))
     (hash 'strategy "unfused-append" 'n n 'cpu_ms cpu 'merge_calls naive-calls))))
(write-json rows)
(newline)
