#lang racket/base
(define tag (make-continuation-prompt-tag 'amb))
(define (h0 thk) (thk))
;; V1: shift via default handler (prompt reinstalled for body)
(define-syntax-rule (reset1 e) (call-with-continuation-prompt (λ () e) tag))
(define-syntax-rule (shift1 k body)
  (call-with-composable-continuation
   (λ (k0) (abort-current-continuation tag (λ () (let ([k (λ (v) (call-with-continuation-prompt (λ () (k0 v)) tag))]) body)))) tag))
;; V2: shift0 (handler does not reinstall)
(define-syntax-rule (reset0 e) (call-with-continuation-prompt (λ () e) tag h0))
(define-syntax-rule (shift0 k body)
  (call-with-composable-continuation
   (λ (k0) (abort-current-continuation tag (λ () (let ([k (λ (v) (call-with-continuation-prompt (λ () (k0 v)) tag h0))]) body)))) tag))
(printf "prompt in body: V1 ~a V2 ~a\n" (reset1 (shift1 k (continuation-prompt-available? tag))) (reset0 (shift0 k (continuation-prompt-available? tag))))
(define N 1000000)
(define-syntax-rule (bench name e)
  (begin (collect-garbage)
    (let ([m0 (current-memory-use 'cumulative)] [t0 (current-process-milliseconds)])
      (for ([_ (in-range N)]) e)
      (printf "~a ~a ns ~a B\n" name (quotient (* 1000000 (- (current-process-milliseconds) t0)) N) (quotient (- (current-memory-use 'cumulative) m0) N)))))
(define (deep n thk) (if (zero? n) (thk) (add1 (deep (sub1 n) thk))))
(for ([_ 2])
  (bench "V1 abort only     " (reset1 (abort-current-continuation tag (λ () 1))))
  (bench "V2 abort only     " (reset0 (abort-current-continuation tag (λ () 1))))
  (bench "V1 discard k      " (reset1 (shift1 k 1)))
  (bench "V2 discard k      " (reset0 (shift0 k 1)))
  (bench "V1 resume k       " (reset1 (+ 1 (shift1 k (k 1)))))
  (bench "V2 resume k       " (reset0 (+ 1 (shift0 k (k 1)))))
  (bench "V1 3 pauses chain " (reset1 (begin (shift1 k (k 1)) (shift1 k (k 1)) (shift1 k (k 1)))))
  (bench "V2 3 pauses chain " (reset0 (begin (shift0 k (k 1)) (shift0 k (k 1)) (shift0 k (k 1)))))
  (bench "V1 depth20 resume " (reset1 (deep 20 (λ () (shift1 k (k 1))))))
  (bench "V2 depth20 resume " (reset0 (deep 20 (λ () (shift0 k (k 1)))))))
