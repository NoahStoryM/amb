#lang racket/base
(define tag (make-continuation-prompt-tag 'amb))
(define (fail/capture) (call-with-composable-continuation (λ (k) (abort-current-continuation tag (λ () 'failed))) tag))
(define (fail/abort) (abort-current-continuation tag (λ () 'failed)))
(define (try f) (with-handlers ([exn:fail? exn-message]) (call-with-continuation-prompt (λ () (call-with-exception-handler (λ (e) (f)) (λ () (raise 'x)))) tag)))
(printf "in exception handler: abort ~s\n" (try fail/abort))
(define N 1000000)
(define-syntax-rule (bench name e)
  (begin (collect-garbage)
    (let ([m0 (current-memory-use 'cumulative)] [t0 (current-process-milliseconds)])
      (for ([_ (in-range N)]) e)
      (printf "~a ~a ns ~a B\n" name (quotient (* 1000000 (- (current-process-milliseconds) t0)) N) (quotient (- (current-memory-use 'cumulative) m0) N)))))
(for ([_ 2])
(bench "capture+abort" (call-with-continuation-prompt (λ () (fail/capture)) tag))
(bench "abort only   " (call-with-continuation-prompt (λ () (fail/abort)) tag)))
